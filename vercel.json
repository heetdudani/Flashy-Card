{
    "builds": [{
        "src": "FlashyCard/wsgi.py",  <-- Points to the inner folder
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
    }],
    "routes": [{
        "src": "/(.*)",
        "dest": "FlashyCard/wsgi.py"  <-- Points to the inner folder
    }]
}
